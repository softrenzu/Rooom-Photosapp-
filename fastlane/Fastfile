default_platform(:ios)

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: false
  )
end

platform :ios do
  desc "Upload App Store text and validated screenshots"
  lane :metadata do
    deliver(
      api_key: connect_api_key,
      app_identifier: "com.rooomtech.rooomshot",
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload an IPA and optionally submit version 1.0.0 for review"
  lane :submit do
    should_submit = ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"
    subscription_ready = ENV.fetch("SUBSCRIPTION_REVIEW_READY", "false") == "true"
    if should_submit && !subscription_ready
      UI.user_error!("The first ¥500 monthly subscription must be complete and added to the app review before submission.")
    end

    upload_to_app_store(
      api_key: connect_api_key,
      app_identifier: "com.rooomtech.rooomshot",
      ipa: ENV.fetch("IPA_PATH"),
      submit_for_review: should_submit,
      automatic_release: false,
      phased_release: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        content_rights_contains_third_party_content: false,
        content_rights_has_rights: true
      }
    )
  end
end
